    "test:doctor-profile-schedule": "node src/scripts/testDoctorProfileSchedule.js",
    "test:doctor-reviews": "node src/scripts/testDoctorReviews.js",
    "test:system-integration": "node src/scripts/testSystemIntegration.js",
    "test:security": "node src/scripts/testSecurityHardening.js",
